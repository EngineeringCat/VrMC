{
  "controller_type": "oculus_touch",
  "description": "VrMC: hold grip or trigger on an empty part of the panel to move it",
  "name": "VrMC default",
  "bindings": {
    "/actions/vrmc": {
      "sources": [
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/vrmc/in/grab" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/vrmc/in/grab" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "button", "inputs": { "click": { "output": "/actions/vrmc/in/grab" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "button", "inputs": { "click": { "output": "/actions/vrmc/in/grab" } } }
      ]
    }
  }
}
